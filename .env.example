# Relative database paths resolve from the project root, not the terminal cwd.
ASC_DATABASE_URL=sqlite:///./data/aftersale.db
ASC_LOG_LEVEL=INFO
ASC_HIGH_AMOUNT_THRESHOLD=1000.00
ASC_RETURN_WINDOW_DAYS=7
ASC_QUALITY_WINDOW_DAYS=30
# Stage 4: real local accounts; demo identity headers are no longer accepted.
ASC_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP only. HTTPS deployments must enable Secure cookies.
ASC_COOKIE_SECURE=false

# Stage 3: DeepSeek tool-calling model. No network calls until BOTH model and key are set.
ASC_LLM_BASE_URL=https://api.deepseek.com
ASC_LLM_MODEL=
ASC_LLM_API_KEY=
ASC_LLM_TIMEOUT_SECONDS=20
ASC_LLM_MAX_RETRIES=1
ASC_LLM_MAX_OUTPUT_TOKENS=1024
ASC_AGENT_MAX_STEPS=8
ASC_AGENT_MAX_TOOLS=12
ASC_AGENT_TIMEOUT_SECONDS=90
ASC_AGENT_CONTEXT_CHARS=40000
